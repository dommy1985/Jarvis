# Copy to .env and fill in. Empty values disable the feature they belong to.

# Timezone of the containers (also set owner.timezone in config/projects.yaml).
TZ=UTC

# Shared secret between n8n and the Jarvis server (openssl rand -hex 32).
JARVIS_API_TOKEN=
# Token of the runner, only for the /runner/ routes (openssl rand -hex 32).
JARVIS_RUNNER_TOKEN=

# Telegram: a dedicated bot, one group, one topic. Jarvis answers only OWNER_ID in that topic.
TELEGRAM_JARVIS_BOT_TOKEN=
TELEGRAM_JARVIS_CHAT_ID=
TELEGRAM_JARVIS_THREAD_ID=
TELEGRAM_JARVIS_OWNER_ID=

# GitHub token for ingest (read) and for the Telegram GitHub commands (issues, assignees, boards).
# Prefer a fine-grained token limited to the repos in projects.yaml.
GITHUB_TOKEN=
GITHUB_JARVIS_TOKEN=

# Jira Cloud (optional, used by the n8n ingest workflow).
JIRA_EMAIL=
JIRA_API_TOKEN=

# Claude Code for the planner: output of `claude setup-token`. Not needed if the planner uses another provider.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional overrides.
# JARVIS_IMAGE=ghcr.io/<owner>/<name>:<tag>
# JARVIS_PORT=8090
# JARVIS_CONFIG_DIR=./config
# N8N_HOST=localhost
# WEBHOOK_URL=
