{
  "name": "jarvis-briefing",
  "nodes": [
    {
      "id": "jb-schedule",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "10 8 * * *"
            }
          ]
        }
      }
    },
    {
      "id": "jb-manual",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        200
      ],
      "parameters": {}
    },
    {
      "id": "jb-plan",
      "name": "Jarvis - plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "http://jarvis:8080/plan",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ if_missing: true }) }}",
        "options": {
          "timeout": 360000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Jarvis API"
        }
      }
    },
    {
      "id": "jb-tg-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.5,
      "position": [
        0,
        460
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {
          "chatIds": "REPLACE_WITH_TELEGRAM_GROUP_ID",
          "userIds": "27059963"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Jarvis Telegram"
        }
      }
    },
    {
      "id": "jb-reply",
      "name": "Jarvis - reply",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        240,
        460
      ],
      "parameters": {
        "method": "POST",
        "url": "http://jarvis:8080/reply",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.message.chat.id, thread_id: $json.message.message_thread_id || null, from_id: $json.message.from.id, message_id: $json.message.message_id, text: $json.message.text || null }) }}",
        "options": {
          "timeout": 360000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Jarvis API"
        }
      }
    },
    {
      "id": "jb-has-message",
      "name": "Da inviare?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        280
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "jb-has-message-c",
              "leftValue": "={{ !!$json.message }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "jb-send",
      "name": "Telegram - Jarvis",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        260
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.message.chat_id }}",
        "text": "={{ $json.message.text }}",
        "additionalFields": {
          "appendAttribution": false,
          "parse_mode": "HTML",
          "disable_web_page_preview": true,
          "message_thread_id": "={{ $json.message.thread_id }}"
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Jarvis Telegram"
        }
      }
    },
    {
      "id": "jb-is-briefing",
      "name": "È il briefing?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        960,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "jb-is-briefing-c",
              "leftValue": "={{ $('Da inviare?').item.json.is_briefing === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "jb-sent",
      "name": "Jarvis - sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        1200,
        240
      ],
      "parameters": {
        "method": "POST",
        "url": "http://jarvis:8080/briefing/sent",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ date: $('Da inviare?').item.json.date, message_id: $json.result.message_id }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WITH_CREDENTIAL_ID",
          "name": "Jarvis API"
        }
      }
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Jarvis - plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual Trigger": {
      "main": [
        [
          {
            "node": "Jarvis - plan",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Jarvis - plan": {
      "main": [
        [
          {
            "node": "Da inviare?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Jarvis - reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Jarvis - reply": {
      "main": [
        [
          {
            "node": "Da inviare?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Da inviare?": {
      "main": [
        [
          {
            "node": "Telegram - Jarvis",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    },
    "Telegram - Jarvis": {
      "main": [
        [
          {
            "node": "È il briefing?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "È il briefing?": {
      "main": [
        [
          {
            "node": "Jarvis - sent",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
