<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Installato da scripts/install-runner.sh in ~/Library/LaunchAgents: gira solo con l'utente loggato. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@UV@</string><string>run</string><string>--project</string><string>@REPO@</string>
    <string>python</string><string>-m</string><string>runner.runner</string>
  </array>
  <key>WorkingDirectory</key><string>@REPO@</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>@LOG@</string>
  <key>StandardErrorPath</key><string>@LOG@</string>
</dict>
</plist>
